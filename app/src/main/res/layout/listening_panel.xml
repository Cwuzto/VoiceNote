<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/listeningPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="16dp"
    android:elevation="8dp">

    <com.example.voicenote.ui.custom.WaveformView
        android:id="@+id/waveView"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvListenHint"
        android:layout_below="@+id/waveView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hãy thử nói: “2 bánh mì 5,000”"
        android:textColor="#0c88c2"
        android:layout_marginTop="4dp"
        android:layout_centerHorizontal="true"/>

    <LinearLayout
        android:id="@+id/listenButtons"
        android:layout_below="@id/tvListenHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/btnCancelListening"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_badge_remove"
            android:src="@drawable/ic_delete_24"/>

        <ImageButton
            android:id="@+id/btnSendListening"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:background="@drawable/bg_badge_circle"
            android:src="@drawable/ic_send"/>
    </LinearLayout>

</RelativeLayout>
