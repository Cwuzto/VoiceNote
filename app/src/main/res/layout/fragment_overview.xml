<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_soft"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Logo placeholder (có thể thay bằng ImageView logo của bạn) -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_home_24"
                app:tint="@color/brand_blue"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/overview_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="22sp"/>
        </LinearLayout>

        <!-- 2 ô thống kê nhỏ -->
        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:orientation="horizontal">

            <!-- Doanh thu -->
            <LinearLayout
                android:id="@+id/tileRevenue"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_16"
                android:padding="12dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_trending_24"
                    app:tint="@color/brand_blue"/>

                <TextView
                    android:id="@+id/tvRevenueValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvRevenueTimeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doanh thu tháng này"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:drawableEnd="@drawable/ic_arrow_down_24"
                    android:drawablePadding="4dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp"/>

            <!-- Đơn tháng này -->
            <LinearLayout
                android:id="@+id/tileOrders"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_16"
                android:padding="12dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_receipt_long_24"
                    app:tint="@color/brand_blue"/>

                <TextView
                    android:id="@+id/tvOrdersValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvOrderTimeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orders_this_month"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card Doanh thu -->
        <LinearLayout
            android:id="@+id/cardRevenue"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_16"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title + chip Tháng này -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/revenue_card_title"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/chipRevenueChartTimeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_overview"
                    android:text="| Tháng này"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:drawableStart="@drawable/ic_clock_24"
                    android:drawablePadding="6dp"/>
            </LinearLayout>


            <!-- EMPTY STATE (groupEmptyRevenue) -->
            <LinearLayout
                android:id="@+id/groupEmptyRevenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_trending_24"
                    app:tint="@color/brand_blue"/>

                <TextView
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_revenue_desc"
                    android:textColor="@color/text_muted"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoToSale"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cta_create_dummy_order"/>
            </LinearLayout>

            <!-- DATA STATE (groupDataRevenue) có số liệu -->
            <LinearLayout
                android:id="@+id/groupDataRevenue"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="200dp" android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"/>

                <LinearLayout
                    android:id="@+id/chartEmptyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_trending_24"
                        app:tint="#D1D5DB"
                        android:background="@drawable/bg_circle_soft"
                        android:padding="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có dữ liệu"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Card Hàng hoá bán chạy -->
        <LinearLayout
            android:id="@+id/cardBestseller"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_16"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title + chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/bestseller_title"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/chipBestSellerTimeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_overview"
                    android:text="| Tháng này"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:drawableStart="@drawable/ic_clock_24"
                    android:drawablePadding="6dp"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/groupEmptyBest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="visible">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_receipt_long_24"
                    app:tint="@color/brand_blue"/>
                <TextView
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có dữ liệu bán chạy"
                    android:textColor="@color/text_muted"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupDataBest"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <LinearLayout
                    android:id="@+id/containerBestSellers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/btnViewAllBestSellers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textColor="@color/brand_blue"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="8dp"
                    android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="20dp"/>
    </LinearLayout>
</ScrollView>