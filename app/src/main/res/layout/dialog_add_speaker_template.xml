<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottomsheet_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cập nhật nội dung loa thông báo"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#0F172A"/>
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xong"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:textSize="16sp"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/edtContent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nội dung thông báo phát loa"
            android:background="@null"
            android:textSize="16sp"
            android:maxLength="50"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical">

            <ImageView
                android:id="@+id/btnClear"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close_24"
                app:tint="#9CA3AF"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/btnTestSound"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_speaker_24"
                app:tint="#64748B"/>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0/50 ký tự"
        android:textSize="12sp"
        android:textColor="#9CA3AF"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/chipInsertMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="{Số tiền}"
        android:textColor="#64748B"
        android:textStyle="bold"
        android:background="@drawable/bg_outline_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="24dp"/>

</LinearLayout>